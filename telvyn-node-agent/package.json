{
  "name": "@telvyn/node-agent",
  "version": "0.4.1",
  "description": "Telvyn HTTP, Express and database instrumentation through the existing OTLP collector",
  "main": "register.cjs",
  "exports": {
    ".": "./register.cjs",
    "./register": "./register.cjs"
  },
  "files": [
    "register.cjs",
    "bootstrap.cjs",
    "profiler.cjs",
    "profile-context.cjs",
    "routes.cjs",
    "security.cjs",
    "iast.cjs",
    "debugger.cjs",
    "runtime.cjs",
    "loader.mjs",
    "README.md",
    "mariadb.cjs",
    "remote.cjs",
    "protection.cjs",
    "frameworks.cjs",
    "waf-rules.json",
    "WAF-RULES-NOTICE.md"
  ],
  "engines": {
    "node": "^18.19.0 || >=20"
  },
  "dependencies": {
    "@fastify/otel": "0.21.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-mysql": "0.69.0",
    "@opentelemetry/instrumentation-mysql2": "0.69.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "acorn": "8.14.0",
    "import-in-the-middle": "3.5.2"
  },
  "optionalDependencies": {
    "@datadog/native-appsec": "11.0.3",
    "@datadog/native-iast-taint-tracking": "4.2.1",
    "@datadog/pprof": "5.20.0",
    "@datadog/wasm-js-rewriter": "5.0.4"
  }
}
