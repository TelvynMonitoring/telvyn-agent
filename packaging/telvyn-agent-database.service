[Unit]
Description=Telvyn Agent de Banco
Documentation=https://docs.telvyn.com.br/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telvyn-database
Group=telvyn-database
EnvironmentFile=-/etc/telvyn/database-agent.env
ExecStart=/usr/local/bin/telvyn-agent-database
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=5

# O Agent de Banco não abre receptor OTLP, eBPF, logs ou SNMP. Mantém só as
# capacidades necessárias para as métricas locais do host do PostgreSQL.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/telvyn-agent/database /var/log/telvyn-agent/database

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=default
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io @reboot @swap @clock @module
SystemCallArchitectures=native
KeyringMode=private
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telvyn-agent-database

[Install]
WantedBy=multi-user.target
