<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>system.monitoring</groupId>
    <artifactId>telvyn-debugger</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <!--
      Telvyn Debugger — javaagent (live debugger com instrumentação
      dinâmica), SÓ JAVA. O cliente anexa este jar ao app dele com
      -javaagent:telvyn-debugger.jar. Ele "fotografa" entrada/saída/erro de
      métodos configurados, em runtime, SEM parar o app (ByteBuddy reescreve o
      bytecode). v1: prova de conceito — captura e imprime a foto.

      Empacotado como fat-jar (ByteBuddy embutido) — o javaagent é carregado
      standalone pela JVM, então tem que ser auto-contido.
      TODO produção: relocar net.bytebuddy (shade relocation) pra não colidir
      com uma versão do ByteBuddy que o app do cliente já use.
    -->

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Item 3: -parameters guarda os nomes reais dos parâmetros no .class,
             pra o advice ler method.getParameters()[i].getName() em runtime. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bytebuddy.version>1.14.18</bytebuddy.version>
        <chicory.version>1.7.5</chicory.version>
    </properties>

    <dependencies>
        <dependency>
            <!-- Runtime de WebAssembly em Java puro: roda o libinjection (src/main/wasm) sem biblioteca nativa. -->
            <groupId>com.dylibso.chicory</groupId><artifactId>runtime</artifactId><version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.3</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>telvyn-debugger-${project.version}</finalName>
        <plugins>
            <plugin>
                <!-- libinjection.wasm vira bytecode Java no build (LibInjectionModule): rápido e sem interpretador. -->
                <groupId>com.dylibso.chicory</groupId>
                <artifactId>chicory-compiler-maven-plugin</artifactId>
                <version>${chicory.version}</version>
                <executions>
                    <execution>
                        <id>libinjection</id>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <name>system.monitoring.debugger.waf.LibInjectionModule</name>
                            <wasmFile>src/main/wasm/libinjection.wasm</wasmFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <relocations><relocation><pattern>com.google.gson</pattern><shadedPattern>system.monitoring.debugger.shaded.gson</shadedPattern></relocation><relocation><pattern>com.dylibso.chicory</pattern><shadedPattern>system.monitoring.debugger.shaded.chicory</shadedPattern></relocation></relocations>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>system.monitoring.debugger.TelvynDebuggerAgent</Premain-Class>
                                        <Agent-Class>system.monitoring.debugger.TelvynDebuggerAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
